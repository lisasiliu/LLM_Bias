# Scratch output of the default --out-dir; the curated copy is offline_fixture/.
research/validation_runs/latest/

# Raw LURK game runs used as fresh validation sources: regenerate with
# lurkingwolf.run_game rather than versioning transcripts. The derived sample
# and its provenance are committed under experiments/politeness_validation/data/.
games_fresh/
# Local raw games for proficiency validation. Curated source records and reports
# belong in experiments/language_validation/data/.
/experiments/validation/
__pycache__/
*.pyc

# automated tests are kept local
tests/

# original 48-item validation (kept locally)
experiments/politeness_validation/data/original_48/

# game outputs
games/

# Cluster job scripts and per-cluster settings for the proficiency pilot; kept local for now.
/experiments/language_validation/hpc/

# Resume artifacts of interrupted proficiency runs (the manifest records completed outputs)
*.partial

# Flip replay results: the game trees, the run artifacts and the figures stay local.
# The cluster holds the full trees, including the LLM call logs and the checkpoints.
/experiments/language_flip/games/
/experiments/language_flip/games_raters_unexposed/
/experiments/language_flip/data/runs/
# Figures are regenerated from the recorded games by each experiment's figures.py
experiments/*/figures/
!experiments/natural_politeness/figures/
# Everything the cluster produced and everything built from it: the summaries and the
# validation report are rebuilt by analyze.py and the validation CLI from the recorded runs.
/experiments/language_flip/summary.md
/experiments/language_validation/data/runs/
/experiments/language_validation/data/automatic_validation.jsonl
/experiments/language_validation/data/provenance.json
/experiments/language_validation/VALIDATION.md
# Per-call token and spend records of the paid judges
experiments/language_validation/data/api_usage.jsonl

# Judge-calibration items are repeated verbatim inside judged.jsonl
experiments/language_validation/data/runs/*/validation/calibration/items.jsonl
experiments/language_validation/data/runs/*/rewrite/shards/
experiments/language_validation/data/runs/*/validation/calibration/shards/
experiments/language_validation/data/runs/*/logs/

experiments/politeness_experiment/data/run_log.jsonl

# Local test suites for the language experiments; kept on disk, not in the branch
/experiments/language_flip/tests/
/experiments/language_validation/tests/
