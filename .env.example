# Environment variables for LurkingWolf. Copy this file to .env (ignored by git) and fill in the values.
# Any OpenAI-compatible server works for the game model (vLLM, Ollama, LiteLLM, TGI, OpenRouter).
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.5-27B

# Judge, rewriter and listener providers used by the validation experiments.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# SUBTLEX-US word-frequency file (lexical measures and Neutral candidate selection).
SUBTLEX=
